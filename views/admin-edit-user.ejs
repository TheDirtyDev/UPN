<%- include('partials/header') %>

<style>
    .edit-container {
        flex: 1;
        padding: 40px 5%;
        background-color: #0b0f19;
        display: flex;
        flex-direction: column;
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .edit-header h2 {
        color: #ffffff;
        font-size: 1.5rem;
        margin-bottom: 4px;
    }

    .edit-header p {
        color: #9ca3af;
        font-size: 0.9rem;
    }

    /* Grid layout for Application Details + Admin Form */
    .review-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 30px;
        align-items: start;
    }

    @media (max-width: 1024px) {
        .review-grid {
            grid-template-columns: 1fr;
        }
    }

    .edit-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 12px;
        padding: 30px;
        width: 100%;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        margin-bottom: 20px;
    }

    .edit-card h3 {
        color: #ffffff;
        font-size: 1.2rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #1f2937;
        padding-bottom: 12px;
    }

    /* Application Data List Styling */
    .app-field-group {
        margin-bottom: 16px;
        font-size: 0.9rem;
    }

    .app-field-group label {
        display: block;
        color: #9ca3af;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }

    .app-field-value {
        color: #f3f4f6;
        background-color: #0b0f19;
        border: 1px solid #1f2937;
        padding: 10px 14px;
        border-radius: 8px;
        line-height: 1.4;
    }

    .app-field-value.text-block {
        max-height: 150px;
        overflow-y: auto;
        white-space: pre-wrap;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        color: #d1d5db;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-group input, .form-group select {
        width: 100%;
        background-color: #0b0f19;
        border: 1px solid #374151;
        border-radius: 8px;
        padding: 12px 16px;
        color: #ffffff;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-group input:focus, .form-group select:focus {
        border-color: #4f46e5;
    }

    /* Status indicator preview styling */
    .status-preview {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: bold;
        padding: 4px 10px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-left: 8px;
    }
    .status-preview.approved { background-color: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-preview.pending { background-color: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-preview.denied { background-color: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-save {
        flex: 1;
        background-color: #4f46e5;
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-save:hover {
        background-color: #4338ca;
    }

    .btn-cancel {
        flex: 1;
        background-color: #1f2937;
        color: #ffffff;
        border: 1px solid #374151;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .btn-cancel:hover {
        background-color: #374151;
    }
</style>

<main class="edit-container">
    <div class="edit-header">
        <div>
            <h2>Review Application: <%= targetUser.username %></h2>
            <p>Evaluate submitted questionnaire responses and process whitelist status.</p>
        </div>
        <a href="/admin" class="btn-cancel" style="flex: unset; padding: 10px 20px; font-size: 0.9rem;">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="review-grid">
        
        <!-- LEFT COLUMN: Submitted Application Questionnaire -->
        <div class="edit-card">
            <h3><i class="fa-solid fa-file-lines" style="color: #4f46e5;"></i> Applicant Questionnaire</h3>

            <div class="app-field-group">
                <label>IRL Name</label>
                <div class="app-field-value"><%= targetUser.irl_name || 'Not provided' %></div>
            </div>

            <div class="app-field-group">
                <label>IRL Age / Birthday</label>
                <div class="app-field-value"><%= targetUser.irl_age_bday || 'Not provided' %></div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px;">
                <div class="app-field-group">
                    <label>RP Name</label>
                    <div class="app-field-value"><%= targetUser.rp_name || 'Not provided' %></div>
                </div>
                <div class="app-field-group">
                    <label>RP Age</label>
                    <div class="app-field-value"><%= targetUser.rp_age || 'N/A' %></div>
                </div>
            </div>

            <div class="app-field-group">
                <label>RP Address / Residence</label>
                <div class="app-field-value"><%= targetUser.rp_address || 'Not provided' %></div>
            </div>

            <div class="app-field-group">
                <label>Character Description</label>
                <div class="app-field-value text-block"><%= targetUser.rp_description || 'None provided.' %></div>
            </div>

            <div class="app-field-group">
                <label>Character Backstory & History</label>
                <div class="app-field-value text-block"><%= targetUser.rp_story || 'None provided.' %></div>
            </div>

            <div class="app-field-group">
                <label>Joined RP / FiveM Experience Time</label>
                <div class="app-field-value"><%= targetUser.fivem_time || 'Not provided' %></div>
            </div>

            <div class="app-field-group">
                <label>Previous Servers</label>
                <div class="app-field-value"><%= targetUser.previous_servers || 'None' %></div>
            </div>

            <div class="app-field-group">
                <label>About Yourself</label>
                <div class="app-field-value text-block"><%= targetUser.about_yourself || 'None provided.' %></div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Personnel & Status Form -->
        <div>
            <!-- Status Review Card -->
            <div class="edit-card">
                <h3><i class="fa-solid fa-list-check" style="color: #f59e0b;"></i> Application Decision</h3>

                <form action="/admin/user/<%= targetUser.id %>" method="POST">
                    
                    <div class="form-group">
                        <label for="whitelistStatus">
                            Whitelist Status 
                            <% 
                                let currentStatusClass = 'pending';
                                if (targetUser.whitelistStatus === 'Approved') currentStatusClass = 'approved';
                                if (targetUser.whitelistStatus === 'Denied') currentStatusClass = 'denied';
                            %>
                            <span id="statusBadgePreview" class="status-preview <%= currentStatusClass %>"><%= targetUser.whitelistStatus || 'Pending Review' %></span>
                        </label>
                        <select id="whitelistStatus" name="whitelistStatus" onchange="updateStatusBadgePreview(this)">
                            <option value="Pending Review" <%= targetUser.whitelistStatus === 'Pending Review' || !targetUser.whitelistStatus ? 'selected' : '' %>>Pending Review</option>
                            <option value="Approved" <%= targetUser.whitelistStatus === 'Approved' ? 'selected' : '' %>>Approved (Whitelist Access)</option>
                            <option value="Denied" <%= targetUser.whitelistStatus === 'Denied' ? 'selected' : '' %>>Denied</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="callsign">In-Game Callsign</label>
                        <input type="text" id="callsign" name="callsign" value="<%= targetUser.callsign || '' %>" placeholder="e.g., 1-Adam-12">
                    </div>

                    <div class="form-group">
                        <label for="department">Department / Division</label>
                        <input type="text" id="department" name="department" value="<%= targetUser.department || '' %>" placeholder="e.g., State Police">
                    </div>

                    <div class="form-group">
                        <label for="strikes">Active Strikes Count</label>
                        <input type="number" id="strikes" name="strikes" min="0" max="10" value="<%= targetUser.strikes || 0 %>">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Decision</button>
                        <a href="/admin" class="btn-cancel">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</main>

<script>
    function updateStatusBadgePreview(selectElement) {
        const preview = document.getElementById('statusBadgePreview');
        const val = selectElement.value;
        
        preview.textContent = val;
        preview.className = 'status-preview';
        
        if (val === 'Approved') {
            preview.classList.add('approved');
        } else if (val === 'Denied') {
            preview.classList.add('denied');
        } else {
            preview.classList.add('pending');
        }
    }
</script>

<%- include('partials/footer') %>