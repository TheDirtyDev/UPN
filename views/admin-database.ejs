<%- include('partials/header') %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Database Inspector // UPN Admin</title>
        <link rel="stylesheet" href="/css/style.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <script src="https://cdn.tailwindcss.com"></script>
    </head>

    <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">


        <!-- Main Content Body -->
        <main class="max-w-7xl w-full mx-auto px-6 py-8 flex-grow">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                        <i class="fa-solid fa-database text-blue-500"></i> Mongoose Database Inspector
                    </h1>
                    <p class="text-xs text-slate-400 mt-1">Live MongoDB cluster insight showing registered models,
                        schemas, fields, and records.</p>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="location.reload()"
                        class="flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-200 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition shadow-sm cursor-pointer">
                        <i class="fa-solid fa-rotate-right"></i> Refresh Data
                    </button>
                </div>
            </div>

            <!-- Loop Through Each Detected Mongoose Model -->
            <% if (collections && collections.length> 0) { %>
                <% collections.forEach(col=> { %>
                    <div
                        class="bg-slate-900/40 border border-slate-800 rounded-xl overflow-hidden shadow-xl backdrop-blur-sm mb-8">

                        <!-- Collection Header & Global Action -->
                        <div
                            class="px-6 py-4 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900/80">
                            <div>
                                <h3 class="text-base font-bold text-white flex items-center gap-2">
                                    <i class="fa-solid fa-table-cells text-blue-400"></i> Model: <%= col.name %>
                                        <span
                                            class="ml-2 px-2.5 py-0.5 text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 rounded-full">
                                            <%= col.count %> total records
                                        </span>
                                </h3>
                            </div>

                            <!-- Danger Action: Clear Whole Collection -->
                            <form action="/admin/database/<%= col.name %>/clear" method="POST"
                                onsubmit="return confirm('DANGER: Are you sure you want to delete ALL records inside <%= col.name %>? This action is irreversible!');">
                                <button type="submit"
                                    class="flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-red-400 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 rounded-lg transition cursor-pointer">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Clear Entire Collection
                                </button>
                            </form>
                        </div>

                        <!-- Schema Field Definitions -->
                        <div
                            class="px-6 py-3 bg-slate-950/40 border-b border-slate-800/60 flex items-center gap-2 overflow-x-auto text-xs">
                            <span class="text-slate-400 font-semibold uppercase tracking-wider flex-shrink-0">Fields &
                                Types:</span>
                            <% col.fields.forEach(field=> { %>
                                <span
                                    class="px-2 py-1 bg-slate-800 text-slate-300 rounded font-mono text-[11px] border border-slate-700 flex-shrink-0">
                                    <%= field.name %>: <span class="text-blue-400">
                                            <%= field.type %>
                                        </span>
                                </span>
                                <% }) %>
                        </div>

                        <!-- Documents Table View -->
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr
                                        class="border-b border-slate-800 text-slate-400 text-xs font-semibold uppercase tracking-wider bg-slate-900/40">
                                        <th class="px-6 py-3">Identifier / ID</th>
                                        <th class="px-6 py-3">Document Payload (JSON)</th>
                                        <th class="px-6 py-3 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/60 text-sm">
                                    <% if (col.sampleDocs && col.sampleDocs.length> 0) { %>
                                        <% col.sampleDocs.forEach(doc=> { %>
                                            <tr class="hover:bg-slate-800/40 transition">
                                                <td class="px-6 py-4 font-mono text-xs text-slate-400">
                                                    <%= doc.id || doc._id %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 font-mono text-xs text-slate-300 max-w-md truncate">
                                                    <%= JSON.stringify(doc) %>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <!-- Delete Individual Document/User -->
                                                    <form
                                                        action="/admin/database/<%= col.name %>/delete/<%= doc.id || doc._id %>"
                                                        method="POST" class="inline"
                                                        onsubmit="return confirm('Are you sure you want to remove this specific record?');">
                                                        <button type="submit"
                                                            class="px-2.5 py-1 text-xs font-medium text-red-400 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 rounded transition cursor-pointer">
                                                            <i class="fa-solid fa-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="3"
                                                            class="px-6 py-6 text-center text-xs text-slate-500 font-medium">
                                                            No documents found in this model.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <% }) %>
                        <% } else { %>
                            <div
                                class="bg-slate-900/40 border border-slate-800 rounded-xl p-8 text-center text-slate-400">
                                No Mongoose models found. Make sure your models are loaded properly in your application.
                            </div>
                            <% } %>

        </main>

        <!-- Footer -->
        <%- include('partials/footer') %>


    </body>

    </html>